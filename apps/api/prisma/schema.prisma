generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberKey {
  SUMON
  EBRAHIM
}

enum ExpenseCategory {
  GROCERIES
  UTILITIES
  TRANSPORT
  HOUSEHOLD
  MEDICINE
  OTHER
}

enum MutationOperation {
  CREATE
  UPDATE
  DELETE
}

enum ChangeOperation {
  CREATED
  UPDATED
  DELETED
}

enum SyncEntityType {
  EXPENSE
  PERIOD
  LOAN
}

enum DevicePlatform {
  ANDROID
}

model Household {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String              @unique @db.VarChar(64)
  name               String              @db.VarChar(100)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  members            Member[]
  expenses           Expense[]
  spendingPeriods    SpendingPeriod[]
  loanEntries        LoanEntry[]
  processedMutations ProcessedMutation[]
  expenseChanges     ExpenseChange[]
  deviceTokens       DeviceToken[]
}

model Member {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId        String              @db.Uuid
  key                MemberKey
  displayName        String              @db.VarChar(50)
  pinHash            String              @db.Text
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @default(now()) @db.Timestamptz(3)
  disabledAt         DateTime?           @db.Timestamptz(3)
  household          Household           @relation(fields: [householdId], references: [id], onDelete: Restrict)
  refreshTokens      RefreshToken[]
  deviceTokens       DeviceToken[]
  paidExpenses       Expense[]
  owedLoans          LoanEntry[]
  processedMutations ProcessedMutation[]

  @@unique([householdId, key])
  @@unique([householdId, id])
  @@index([householdId])
}

model RefreshToken {
  id                String         @id @db.Uuid
  memberId          String         @db.Uuid
  familyId          String         @db.Uuid
  tokenHash         String         @unique @db.Char(64)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime       @db.Timestamptz(3)
  lastUsedAt        DateTime?      @db.Timestamptz(3)
  revokedAt         DateTime?      @db.Timestamptz(3)
  replacedByTokenId String?        @unique @db.Uuid
  member            Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  replacedBy        RefreshToken?  @relation("RefreshRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces          RefreshToken?  @relation("RefreshRotation")

  @@index([memberId])
  @@index([familyId])
  @@index([expiresAt])
}

/// One installed app that may be woken by a push message.
///
/// Rows are addresses, not credentials, which is the one place this model has to
/// depart from `RefreshToken`: possession of an FCM registration token lets the
/// holder send a message *to* the device, never act *as* the member, and the
/// server has to present the value verbatim to Google, so it cannot be stored as
/// a hash alone. `tokenHash` still carries the uniqueness and upsert key so the
/// fixed-width index habit is preserved and re-registering an unchanged token is
/// a no-op. The composite member relation makes "a device never names a member
/// from another household" a database guarantee, because the send query trusts
/// `householdId` to decide who gets woken.
model DeviceToken {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId String         @db.Uuid
  memberId    String         @db.Uuid
  platform    DevicePlatform @default(ANDROID)
  tokenHash   String         @unique @db.Char(64)
  /// The FCM registration token. Never logged: it is enough to send this device
  /// a notification, so it stays out of every log line and error message.
  token       String         @db.Text
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime       @default(now()) @db.Timestamptz(3)
  /// Set when Google reports the token as gone rather than deleting the row, so
  /// a device that stopped receiving pushes is still visible while diagnosing.
  disabledAt  DateTime?      @db.Timestamptz(3)
  household   Household      @relation(fields: [householdId], references: [id], onDelete: Restrict)
  member      Member         @relation(fields: [householdId, memberId], references: [householdId, id], onDelete: Cascade)

  @@index([householdId, memberId])
  @@index([memberId])
}

model SpendingPeriod {
  id                 String    @id @db.Uuid
  householdId        String    @db.Uuid
  sequenceNumber     Int
  startedAt          DateTime  @db.Timestamptz(3)
  closedAt           DateTime? @db.Timestamptz(3)
  note               String?   @db.VarChar(500)
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @db.Timestamptz(3)
  lastChangeSequence BigInt    @default(0) @db.BigInt
  household          Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  expenses           Expense[]

  @@unique([householdId, id])
  @@unique([householdId, sequenceNumber])
  @@index([householdId, startedAt])
  @@index([householdId, lastChangeSequence])
}

model LoanEntry {
  id                 String    @id @db.Uuid
  householdId        String    @db.Uuid
  debtorId           String    @db.Uuid
  amountMinor        BigInt    @db.BigInt
  occurredAt         DateTime  @db.Timestamptz(3)
  note               String?   @db.VarChar(500)
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt          DateTime? @db.Timestamptz(3)
  lastChangeSequence BigInt    @default(0) @db.BigInt
  household          Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  debtor             Member    @relation(fields: [householdId, debtorId], references: [householdId, id], onDelete: Restrict)

  @@index([householdId, occurredAt])
  @@index([householdId, lastChangeSequence])
  @@index([householdId, debtorId])
}

model Expense {
  id                 String          @id @db.Uuid
  householdId        String          @db.Uuid
  amountMinor        BigInt          @db.BigInt
  category           ExpenseCategory
  payerId            String          @db.Uuid
  periodId           String          @db.Uuid
  occurredAt         DateTime        @db.Timestamptz(3)
  note               String?         @db.VarChar(500)
  version            Int             @default(1)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @default(now()) @db.Timestamptz(3)
  deletedAt          DateTime?       @db.Timestamptz(3)
  lastChangeSequence BigInt          @default(0) @db.BigInt
  household          Household       @relation(fields: [householdId], references: [id], onDelete: Restrict)
  payer              Member          @relation(fields: [householdId, payerId], references: [householdId, id], onDelete: Restrict)
  period             SpendingPeriod  @relation(fields: [householdId, periodId], references: [householdId, id], onDelete: Restrict)

  @@index([householdId, occurredAt])
  @@index([householdId, lastChangeSequence])
  @@index([householdId, payerId])
  @@index([householdId, periodId])
}

model ProcessedMutation {
  mutationId  String            @id @db.Uuid
  householdId String            @db.Uuid
  memberId    String            @db.Uuid
  entityId    String            @db.Uuid
  entityType  SyncEntityType    @default(EXPENSE)
  operation   MutationOperation
  requestHash String            @db.Char(64)
  result      Json              @db.JsonB
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  household   Household         @relation(fields: [householdId], references: [id], onDelete: Restrict)
  member      Member            @relation(fields: [householdId, memberId], references: [householdId, id], onDelete: Restrict)

  @@index([householdId, createdAt])
  @@index([householdId, entityId])
}

/// The ordered change feed for every synchronized entity, not only expenses.
/// `entityType` selects which snapshot shape the `snapshot` document holds. The
/// table keeps its original name so the careful backfill migration that
/// rewrote its stored documents stays untouched.
model ExpenseChange {
  sequence         BigInt          @id @default(autoincrement()) @db.BigInt
  householdId      String          @db.Uuid
  entityId         String          @db.Uuid
  entityType       SyncEntityType  @default(EXPENSE)
  entityVersion    Int
  operation        ChangeOperation
  /// Which member authored this change. Stored as the key rather than a member
  /// relation because the feed is append-only history: the author of a past
  /// change must not move if member rows are ever re-provisioned. A pulling
  /// device compares this against its own member to tell the other member's
  /// activity apart from its own writes echoing back.
  actorMemberKey   MemberKey
  originMutationId String          @unique @db.Uuid
  snapshot         Json            @db.JsonB
  changedAt        DateTime        @default(now()) @db.Timestamptz(3)
  household        Household       @relation(fields: [householdId], references: [id], onDelete: Restrict)

  @@index([householdId, sequence])
  @@index([householdId, entityId, entityVersion])
}
