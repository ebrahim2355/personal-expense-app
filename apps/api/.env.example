# Runtime mode and Railway-injected port
NODE_ENV=<development|test|production>
PORT=<PORT>

# PostgreSQL (Railway provides this value to the API service)
DATABASE_URL=postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public

# Generate independent random values of at least 32 characters
JWT_ACCESS_SECRET=<RANDOM_ACCESS_JWT_SECRET_AT_LEAST_32_CHARACTERS>
CURSOR_SIGNING_SECRET=<RANDOM_CURSOR_HMAC_SECRET_AT_LEAST_32_CHARACTERS>
JWT_ISSUER=<JWT_ISSUER>
JWT_AUDIENCE=<JWT_AUDIENCE>
ACCESS_TOKEN_TTL_SECONDS=<60_TO_3600>
REFRESH_TOKEN_TTL_DAYS=<1_TO_90>

# Optional defense-in-depth pepper; keep stable after provisioning
PIN_PEPPER=<RANDOM_OPTIONAL_PIN_PEPPER>

# Comma-separated exact browser origins. Native Android requests have no Origin.
CORS_ALLOWED_ORIGINS=<HTTPS_ORIGIN_1,HTTPS_ORIGIN_2>

# Railway normally needs one trusted proxy hop in production
TRUST_PROXY_HOPS=<0_TO_5>
JSON_BODY_LIMIT=<SIZE_SUCH_AS_64kb>
RATE_LIMIT_MAX=<POSITIVE_INTEGER>
AUTH_RATE_LIMIT_MAX=<POSITIVE_INTEGER>
RATE_LIMIT_WINDOW_MS=<POSITIVE_INTEGER>

DATABASE_POOL_MAX=<1_TO_50>
DATABASE_CONNECTION_TIMEOUT_MS=<100_TO_60000>
LOG_LEVEL=<fatal|error|warn|info|debug|trace|silent>

# Required only while running the explicit members:provision command.
# Remove these values from the runtime service after successful provisioning.
HOUSEHOLD_SLUG=<LOWERCASE_HOUSEHOLD_SLUG>
HOUSEHOLD_NAME=<HOUSEHOLD_DISPLAY_NAME>
SUMON_INITIAL_PIN=<SUMON_6_TO_12_DIGIT_PIN>
EBRAHIM_INITIAL_PIN=<EBRAHIM_6_TO_12_DIGIT_PIN>
