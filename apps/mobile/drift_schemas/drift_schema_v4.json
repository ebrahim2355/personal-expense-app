  "fixed_sql": [
    {
      "name": "local_expenses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_expenses\" (\"id\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL, \"category\" TEXT NOT NULL, \"payer\" TEXT NOT NULL, \"occurred_at\" INTEGER NOT NULL, \"note\" TEXT NULL, \"period_id\" TEXT NULL, \"version\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"sync_state\" TEXT NOT NULL, \"local_modified_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_periods",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_periods\" (\"id\" TEXT NOT NULL, \"sequence_number\" INTEGER NOT NULL, \"started_at\" INTEGER NOT NULL, \"closed_at\" INTEGER NULL, \"note\" TEXT NULL, \"version\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"sync_state\" TEXT NOT NULL, \"local_modified_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_loans",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_loans\" (\"id\" TEXT NOT NULL, \"debtor\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL, \"occurred_at\" INTEGER NOT NULL, \"note\" TEXT NULL, \"version\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"sync_state\" TEXT NOT NULL, \"local_modified_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "outbox_mutations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outbox_mutations\" (\"local_sequence\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"mutation_id\" TEXT NOT NULL UNIQUE, \"entity_id\" TEXT NOT NULL, \"entity_type\" TEXT NOT NULL DEFAULT 'EXPENSE', \"action\" TEXT NOT NULL, \"base_version\" INTEGER NOT NULL, \"payload_json\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"attempt_count\" INTEGER NOT NULL DEFAULT 0, \"last_attempt_at\" INTEGER NULL, \"next_attempt_at\" INTEGER NULL, \"last_error_code\" TEXT NULL, \"status\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "sync_metadata",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_metadata\" (\"singleton_id\" INTEGER NOT NULL, \"household_id\" TEXT NULL, \"member_id\" TEXT NULL, \"member_key\" TEXT NULL, \"last_cursor\" TEXT NULL, \"bootstrap_page_token\" TEXT NULL, \"bootstrap_watermark\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, \"last_successful_sync_at\" INTEGER NULL, \"notification_permission_requested_at\" INTEGER NULL, \"household_activity_notifications_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"household_activity_notifications_enabled\" IN (0, 1)), PRIMARY KEY (\"singleton_id\"));"
        }
      ]
