<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon, used from API 26. The mipmap-*dpi PNGs beside this file are
     the fallback for API 24 and 25, which this app still supports and which
     cannot read an adaptive icon.

     monochrome lets Android 13+ draw the icon in the member's own wallpaper
     colours. It reuses the foreground because that layer is already a flat white
     silhouette, which is exactly what a themed icon needs. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
